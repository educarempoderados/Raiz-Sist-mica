{
  "entities": {
    "Inscricao": {
      "title": "Inscrição",
      "description": "Dados de inscrição dos leads capturados na landing page.",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome completo do inscrito"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail"
        },
        "whatsapp": {
          "type": "string",
          "description": "Número de WhatsApp com DDI e DDD"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora da inscrição"
        },
        "source": {
          "type": "string",
          "description": "Origem da inscrição"
        }
      },
      "required": ["nome", "email", "whatsapp", "createdAt", "source"]
    },
    "AnalyticsEvent": {
      "title": "Evento de Analytics",
      "description": "Registro de eventos como visitas à página ou cliques.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Tipo de evento, ex: EXIBICAO_PAGINA, CLIQUE_WHATSAPP"
        },
        "path": {
          "type": "string",
          "description": "O caminho da página onde o evento ocorreu"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora do evento"
        }
      },
      "required": ["type", "path", "createdAt"]
    }
  },
  "firestore": {
    "inscricoes/{id}": {
      "schema": "Inscricao",
      "description": "Coleção de inscrições de leads."
    },
    "analytics_events/{id}": {
      "schema": "AnalyticsEvent",
      "description": "Eventos de rastreamento do site."
    }
  }
}
